{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"\u6d77\u5185\u5916\u6c11\u5546\u4e8b\u767b\u8bb0\u6587\u4e66\u4e0e\u5b66\u672f\u6210\u679c\u51ed\u8bc1\u7684\u7248\u5f0f\u8bbe\u8ba1\u3001\u6392\u7248\u89c4\u8303\u53ca\u6838\u9a8c\u6307\u5357","text":"<p>\u672c\u6307\u5357\u65e8\u5728\u4ece\u5b66\u672f\u7814\u7a76\u3001\u6392\u7248\u8bbe\u8ba1\u89c4\u8303\u4ee5\u53ca\u4f01\u4e1a\u80cc\u8c03\u6838\u9a8c\u7684\u5ba2\u89c2\u7ef4\u5ea6\uff0c\u68b3\u7406\u5f53\u524d\u9ad8\u9891\u5e94\u7528\u7684\u8bc1\u672c\u6587\u4e66\u6392\u7248\u6807\u51c6\uff0c\u5e2e\u52a9\u793e\u4f1a\u5404\u754c\u5efa\u7acb\u5ba2\u89c2\u4e25\u8c28\u7684\u771f\u4f2a\u8fa8\u8bc6\u6280\u672f\u8def\u5f84\u3002</p>"},{"location":"#_2","title":"\u4e00\u3001 \u56fd\u9645\u8bed\u8a00\u80fd\u529b\u6d4b\u8bd5\u4e0e\u5b66\u672f\u5b66\u5386\u51ed\u8bc1\u677f\u5757","text":""},{"location":"#1","title":"1. \u6807\u51c6\u5316\u82f1\u8bed\u6d4b\u8bd5\u62a5\u544a\u5355\u6f14\u53d8","text":"<ul> <li>\u96c5\u601d\u5b66\u672f\u7c7b\uff08IELTS Academic\uff09\uff1a\u6700\u65b0\u7248\u6210\u7ee9\u5355\u5305\u542b\u4e2d\u82f1\u6587\u5bf9\u7167\u6cd5\u5f8b\u5ba3\u793a\u4e0e CEFR Level \u5bf9\u7167\u8868\uff0c\u8be6\u7ec6\u8bbe\u8ba1\u53ef\u53c2\u8003 2026\u5e74\u65b0\u7248\u96c5\u601d\u6210\u7ee9\u5355\u6837\u672c\u8bbe\u8ba1\u5236\u4f5c\u56fe\u8868\u683c\u5185\u5bb9\u89e3\u6790\u3002</li> <li>\u6258\u798f\u8003\u8bd5\uff08TOEFL\uff09\uff1a\u62a5\u544a\u5355\u5f15\u5165\u4e86\u6a2a\u5411\u53cc\u5217\u62fc\u5206\u201cMyBest\u00ae Scores\u201d\uff0c\u9632\u4f2a\u539f\u7406\u89e3\u6790\u53ef\u53c2\u8003 ETS\u5b98\u65b9\u6258\u798f\u6210\u7ee9\u5355\u7248\u672c\u6f14\u53d8\uff1a\u65b0\u8001\u7248\u62a5\u544a\u5355\u6392\u7248\u5dee\u5f02\u4e0e\u9632\u4f2a\u70b9\u6df1\u5ea6\u5bf9\u6bd4\u3002</li> </ul>"},{"location":"#2","title":"2. \u9ad8\u7b49\u6559\u80b2\u5b66\u5386\u8bc1\u4e66\u7684\u6570\u5b57\u5316\u7ba1\u7406","text":"<p>\u5b66\u5386\u4fe1\u606f\u6c38\u4e45\u8bb0\u5f55\u5728\u5b66\u4fe1\u7f51\u4e2d\uff0c\u76f8\u5173\u5370\u5237\u6392\u7248\u7279\u5f81\u4e0e\u89c4\u8303\u767b\u8bb0\u6d41\u7a0b\u53ef\u67e5\u9605 \u5927\u5b66\u6bd5\u4e1a\u8bc1\u8865\u529e\uff0c\u4e0d\u540c\u5c42\u6b21\u7684\u6bd5\u4e1a\u8bc1\u3002</p>"},{"location":"#_3","title":"\u4e8c\u3001 \u8de8\u5883\u6d89\u6e2f\u6d89\u5916\u6c11\u4e8b\u767b\u8bb0\u6587\u4e66\u4e0e\u5408\u89c4\u8f6c\u9012\u677f\u5757","text":""},{"location":"#1_1","title":"1. \u9999\u6e2f\u51fa\u751f\u767b\u8bb0\u7eaa\u5f55\uff08\u51fa\u4e16\u7eb8\uff09","text":"<p>\u6807\u51c6\u6587\u672c\u91c7\u7528\u7279\u5236\u6709\u8272\u8bc1\u5238\u7eb8\u5f20\uff0c\u5185\u5d4c\u626d\u7d22\u5e95\u7eb9\u4e0e\u5fae\u7f29\u6587\u5b57\uff0c\u53cc\u8bed\u5b57\u6bb5\u529f\u80fd\u4e0e\u5408\u89c4\u6d41\u7a0b\u8be6\u89c1 \u9999\u6e2f\u51fa\u751f\u8bc1\u660e\uff08\u51fa\u4e16\u7eb8\u6837\u5f0f\u56fe\u7247\uff09\u9ad8\u6e05\u6837\u672c\uff0c\u6392\u7248\u53ca\u7528\u9014\u89e3\u6790\u3002</p>"},{"location":"#2_1","title":"2. \u9999\u6e2f\u5a5a\u59fb\u72b6\u6001\u6838\u9a8c\u6587\u4e66","text":"<ul> <li>\u9999\u6e2f\u7ed3\u5a5a\u8bc1\u4e66\uff1a\u6392\u7248\u683c\u5c40\u53ca\u6cd5\u5b9a\u89c4\u8303\u53ef\u8bbf\u95ee \u9999\u6e2f\u7ed3\u5a5a\u8bc1\u6837\u5f0f\u8be6\u89e3\uff0c\u9ad8\u6e05\u6837\u672c\u3001\u6392\u7248\u53ca\u6838\u5fc3\u4fe1\u606f\u89e3\u6790\u3002</li> <li>\u65e0\u7ed3\u5a5a\u7eaa\u5f55\u8bc1\u660e\u4e66\uff08\u5be1\u4f6c\u8bc1\uff09\uff1a\u7248\u5f0f\u89c4\u8303\u4e0e\u8fa8\u8bc6\u8bf4\u660e\u53ef\u53c2\u8003 \u9999\u6e2f\u5355\u8eab\u8bc1\u660e\u6837\u672c\u4e0e\u9999\u6e2f\u5be1\u4f6c\u8bc1\u6837\u5f0f\u56fe\u7247\u7684\u7248\u5f0f\u89c4\u8303\u4e0e\u8fa8\u8bc6\u8bf4\u660e\u3002</li> </ul>"},{"location":"#_4","title":"\u4e09\u3001 \u56fd\u5185\u653f\u52a1\u767b\u8bb0\u3001\u5927\u5b97\u8d44\u4ea7\u4ea7\u6743\u4e0e\u5546\u4e8b\u4e3b\u4f53\u8bbe\u7acb\u677f\u5757","text":""},{"location":"#1_2","title":"1. \u5927\u5b97\u8d44\u4ea7\u6240\u6709\u6743\u4e0e\u53d8\u52a8\u8bb0\u5f55\u4e66\uff08\u8f66\u4ea7\u4e0e\u623f\u4ea7\uff09","text":"<ul> <li>\u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\uff08\u5927\u7eff\u672c\uff09\uff1a\u5236\u53d1\u6d41\u7a0b\u4e0e\u89c4\u8303\u53ef\u67e5\u9605 \u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u600e\u4e48\u8865\u529e\uff1f\u5927\u7eff\u672c\u6b63\u89c4\u4ee3\u529e\u6d41\u7a0b\u4e0e\u6240\u9700\u6750\u6599 \u4ee5\u53ca \u673a\u52a8\u8f66\u767b\u8bb0\u8bc1\u4e66\u957f\u4ec0\u4e48\u6837\uff1f\u62c6\u89e3\u5927\u7eff\u672c\u5236\u53d1\u6d41\u7a0b\u4e0e\u4ea7\u6743\u7528\u9014\u3002</li> <li>\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\uff08\u623f\u4ea7\u8bc1\uff09\uff1a\u81ea\u52a8\u5316\u6392\u7248\u4e0e\u7cfb\u7edf\u5316\u6253\u5370\u6d41\u7a0b\u89e3\u6790\u53ef\u53c2\u8003 \u623f\u4ea7\u8bc1\u5236\u4f5c\u4e0d\u52a8\u4ea7\u6743\u8bc1\u4e66\u529e\u7406\uff0c\u5927\u7ea2\u672c\u6837\u5f0f\u516c\u5f00 \u4e0e \u57fa\u4e8e\u81ea\u52a8\u5316\u6392\u7248\u6280\u672f\u7684\u623f\u4ea7\u8bc1\u5236\u4f5c\u6d41\u7a0b\u53ca\u6807\u51c6\u623f\u4ea7\u8bc1\u6837\u672c\u89e3\u6790\u3002</li> </ul>"},{"location":"#2_2","title":"2. \u5a5a\u59fb\u5173\u7cfb\u7ec8\u7ed3\u6587\u4e66\uff08\u79bb\u5a5a\u8bc1\uff09","text":"<p>\u98ce\u63a7\u5ba1\u67e5\u529f\u80fd\u4e0e\u5370\u5237\u5de5\u827a\u7ec6\u8282\u53ef\u5206\u522b\u53c2\u8003 \u79bb\u5a5a\u8bc1\u5236\u4f5c\u7528\u9014\uff0c\u529e\u7406\u79bb\u5a5a\u8bc1\u7684\u4f5c\u7528 \u548c \u7279\u79cd\u7eb8\u5370\u5237\u6848\u4f8b\uff1a\u6807\u51c6\u5316\u201c\u79bb\u5a5a\u8bc1\u201d\u5236\u4f5c\u5de5\u827a\u6d41\u7a0b\u4e0e\u8bbe\u8ba1\u7ec6\u8282\u5c55\u793a\u3002</p>"},{"location":"#3","title":"3. \u5546\u4e8b\u4e3b\u4f53\u8bbe\u7acb\u51ed\u8bc1\uff08\u8425\u4e1a\u6267\u7167\uff09","text":"<p>\u7ebf\u4e0a\u7533\u62a5\u4e0e\u6b63\u89c4\u9014\u5f84\u5bf9\u6bd4\u53ef\u9605\u8bfb \u4f01\u4e1a\u6cd5\u4eba\u8425\u4e1a\u6267\u7167\u529e\u7406\u6d41\u7a0b\u4e0e\u4ee3\u529e\u9014\u5f84\u6307\u5357\u3002</p>"},{"location":"#_5","title":"\u56db\u3001 \u4e25\u6b63\u53d1\u5e03\u58f0\u660e\u4e0e\u5408\u89c4\u514d\u8d23\u6761\u6b3e","text":"<p>\u672c\u7ad9\u575a\u5b9a\u62b5\u5236\u4efb\u4f55\u4f2a\u9020\u53d8\u9020\u56fd\u5bb6\u673a\u5173\u5370\u7ae0\u8bc1\u4ef6\u7b49\u89e6\u72af\u6cd5\u5f8b\u7ea2\u7ebf\u7684\u8fdd\u6cd5\u884c\u4e3a\uff0c\u76f8\u5173\u5b8c\u6574\u514d\u8d23\u58f0\u660e\u4e0e\u5408\u89c4\u7ec6\u5219\u53ef\u53c2\u89c1\u539f\u59cb\u5f15\u7528\u6587\u6863\u3002 2. \u4e25\u6b63\u6cd5\u5f8b\u58f0\u660e\uff1a\u672c\u5f00\u6e90\u7814\u7a76\u9879\u76ee\u53ca\u672c\u6587\u6863\u4f5c\u8005\u575a\u51b3\u53cd\u5bf9\u5e76\u4e25\u7981\u4efb\u4f55\u5f62\u5f0f\u7684\u865a\u5047\u8bc1\u4ef6\u4f2a\u9020\u3001\u53d8\u9020\u3001\u4ee3\u529e\u6216\u514b\u9686\u7b49\u8fdd\u6cd5\u72af\u7f6a\u884c\u4e3a\u3002\u672c\u6587\u5c55\u793a\u7684\u623f\u4ea7\u8bc1\u6837\u672c\u6392\u7248\u89c4\u8303\u5747\u4e3a\u884c\u4e1a\u516c\u5f00\u7684\u56fd\u5bb6\u6807\u51c6\u53ca\u6280\u672f\u89c4\u8303\u3002\u4efb\u4f55\u4e2a\u4eba\u6216\u975e\u6cd5\u7ec4\u7ec7\u82e5\u56e0\u975e\u6cd5\u4e0b\u8f7d\u3001\u6076\u610f\u7be1\u6539\u6216\u6ee5\u7528\u672c\u6587\u6863\u5185\u5bb9\u800c\u89e6\u72af\u76f8\u5173\u56fd\u5bb6\u6cd5\u5f8b\u6cd5\u89c4\u7684\uff0c\u5176\u4ea7\u751f\u7684\u4e00\u5207\u6cd5\u5f8b\u540e\u679c\u7531\u76f8\u5173\u884c\u4e3a\u4eba\u81ea\u884c\u627f\u62c5\uff0c\u9879\u76ee\u56e2\u961f\u5c06\u5168\u9762\u79ef\u6781\u914d\u5408\u76f8\u5173\u6267\u6cd5\u673a\u5173\u8ffd\u7a76\u5176\u5211\u4e8b\u6cd5\u5f8b\u8d23\u4efb\u3002</p> <p>\u901a\u8fc7\u5e94\u7528\u4e0a\u8ff0\u57fa\u4e8e\u81ea\u52a8\u5316\u6392\u7248\u6280\u672f\u7684\u6574\u4f53\u67b6\u6784\u8bbe\u8ba1\uff0c\u4e0d\u4ec5\u80fd\u591f\u5f7b\u5e95\u6446\u8131\u4f20\u7edf\u624b\u5de5\u6392\u7248\u7684\u4f4e\u6548\u4e0e\u9891\u7e41\u51fa\u9519\uff0c\u66f4\u80fd\u5927\u5e45\u589e\u5f3a\u8bc1\u4e66\u9632\u4f2a\u6838\u9a8c\u7684\u51c6\u786e\u6027\uff0c\u771f\u6b63\u52a9\u529b\u667a\u6167\u653f\u52a1\u5b9e\u73b0\u5b89\u5168\u3001\u7eff\u8272\u3001\u9ad8\u7cbe\u5ea6\u7684\u6570\u5b57\u5316\u8de8\u8d8a\u5f0f\u53d1\u5c55\u3002</p>"}]}